<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FFFFFF">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Header Superior Personalizado (Toolbar curva) -->
            <com.dogapp.view.components.CurvedToolbar
                android:id="@+id/curvedToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Campo 1: Nombre de la Mascota -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombreMascota"
                style="Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="24dp"
                android:hint="Nombre de la Mascota"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/box_stroke_purple"
                app:counterEnabled="true"
                app:counterMaxLength="15"
                app:layout_constraintTop_toBottomOf="@id/curvedToolbar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreMascota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/black"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo 2: Raza -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRaza"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:hint="Raza"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/box_stroke_purple"
                app:layout_constraintTop_toBottomOf="@id/tilNombreMascota">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actvRaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="text"
                    android:textColor="@color/black"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo 3: Nombre del Propietario -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombrePropietario"
                style="Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:hint="Nombre del Propietario"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/box_stroke_purple"
                app:counterEnabled="true"
                app:counterMaxLength="30"
                app:layout_constraintTop_toBottomOf="@id/tilRaza">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombrePropietario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/black"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo 4: Teléfono -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:hint="Teléfono"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/box_stroke_purple"
                app:counterEnabled="true"
                app:counterMaxLength="10"
                app:layout_constraintTop_toBottomOf="@id/tilNombrePropietario">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:textColor="@color/black"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Selector de Síntomas -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSintomas"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:hint="Síntomas"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/box_stroke_purple"
                app:layout_constraintTop_toBottomOf="@id/tilTelefono">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerSintomas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:inputType="none"
                    android:cursorVisible="false"
                    android:textColor="@color/black"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Guardar Cita -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarCita"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:enabled="false"
                android:text="Guardar Cita"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pink_primary"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_calendar"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:iconTint="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/tilSintomas" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</layout>
